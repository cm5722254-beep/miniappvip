# ============================
# អាធិរាជរឿង - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================

# Application
NODE_ENV=production
PORT=3000
APP_NAME=អាធិរាជរឿង
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/athibaraj_rueng

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT - User Authentication
JWT_SECRET=your-very-long-random-jwt-secret-min-64-chars
JWT_EXPIRES_IN=7d

# JWT - Admin Authentication (separate secret)
ADMIN_JWT_SECRET=your-very-long-random-admin-jwt-secret-min-64-chars
ADMIN_JWT_EXPIRES_IN=8h

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
TELEGRAM_BOT_USERNAME=ruengvipkhmer_bot
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-openssl-rand-hex-32
# Format: https://t.me/<bot_username>/<mini_app_short_name>
TELEGRAM_MINI_APP_URL=https://t.me/ruengvipkhmer_bot/app

# Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=athibaraj-rueng
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
STORAGE_REGION=auto

# Signed URLs for video playback
SIGNED_URL_SECRET=your-signed-url-secret-min-64-chars
SIGNED_URL_EXPIRES_SECONDS=3600

# Payment
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CORS_ORIGINS=https://app.yourdomain.com,https://your-telegram-domain.com
