# Normalize line endings
* text=auto eol=lf

# Force these to always be LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.prisma text eol=lf

# Binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
